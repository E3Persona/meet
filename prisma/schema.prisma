generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Location ─────────────────────────────────────────────────────────────────
// Hierarchical location system: STATE → DISTRICT (optional) → CITY → VENUE
// - STATE: Top-level (e.g., "Pennsylvania", "Maryland")
// - DISTRICT: Optional regional grouping (e.g., "Southeast PA", "Capital Region")
// - CITY: City-level (e.g., "Philadelphia", "Baltimore")
// - VENUE: Specific venue (e.g., "Philadelphia Marriott Downtown")
// Self-relation via parentId enables:
//   - City-wide search phrases run once per city
//   - Venue-specific phrases run once per venue
//   - Venues queryable/groupable by parent city/district/state

enum LocationType {
  STATE     // Top-level: "Pennsylvania", "Maryland"
  DISTRICT  // Mid-level: "Southeast PA", "Capital Region" (optional)
  CITY      // City-level: "Philadelphia", "Baltimore"
  VENUE     // Bottom-level: "Philadelphia Marriott Downtown"
}

enum VenueType {
  ConventionCenter
  Hotel
  Arena
  Casino
  Fairgrounds
  Museum
  Stadium
  ExpoCenter
  University
  SpecialEventSpace
  Other
}

model Location {
  id        String       @id @default(cuid())
  type      LocationType
  name      String       // State: "Pennsylvania" | District: "Southeast PA" | City: "Philadelphia" | Venue: "Philadelphia Marriott Downtown"
  shortName String?      // Venue only: "Marriott" (from "Tab Name (Short)")
  address   String?      // Venue only
  city      String?      // denormalized for fast filtering (city name for venues, null for state/district)
  state     String?      // denormalized for fast filtering (state code for cities/venues, null for state rows)
  parentId  String?      // Child -> parent (Venue->City, City->District, District->State). Null for STATE rows.
  sourceUrl String?
  venueType VenueType?   // Venue only — convention_center, hotel, arena, etc.
  active         Boolean    @default(true)
  lastIngestedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  parent      Location?    @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Location[]   @relation("LocationHierarchy")
  searchTerms SearchTerm[]
  events      Event[]
  venueDirectorySources VenueDirectorySource[] @relation("VenueDirectorySources")
  venueEvents Event[]     @relation("VenueEvents")
  notes       Note[]      @relation("LocationNotes")

  @@index([type, parentId])
  @@index([state])
  @@index([city])
  @@map("locations")
}

// ─── Search Term ──────────────────────────────────────────────────────────────
// Two ways a search gets run:
//   1. A SearchTemplate (with {CITY}/{VENUE}/{MONTH}/{YEAR} placeholders) is
//      resolved against every active Location of the matching scope.
//   2. A SearchTerm is a literal, already-resolved phrase — either pinned to
//      one specific Location (locationId set) or fully global (locationId null,
//      e.g. "CME Credit", "Road Show").
// This replaces treating every literal keyword as location-bound.

model SearchTerm {
  id         String   @id @default(cuid())
  keyword    String
  locationId String?           // null = global keyword, run everywhere
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("search_terms")
}

enum TemplateScope {
  CITY    // uses {CITY} — resolved once per active CITY location
  VENUE   // uses {VENUE} — resolved once per active VENUE location
  GLOBAL  // no location placeholder — resolved once, run as-is
}

model SearchTemplate {
  id        String        @id @default(cuid())
  template  String        // e.g. "events at {VENUE}", "{CITY} trade show listings"
  scope     TemplateScope @default(CITY)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("search_templates")
}

// ─── Event ────────────────────────────────────────────────────────────────────

enum EventMatchType {
  venue_matched_from_source // VenueDirectorySource.venueId is set — source-certain
  venue_matched             // fuzzy-matched to a venue by name
  location_matched          // city/state text matched to a Location (city-level)
  unmatched                 // no match found, flagged for review
}

model Event {
  id                 String      @id @default(cuid())
  locationId         String
  eventName          String
  eventDateStart     DateTime?
  eventDateEnd       DateTime?
  expectedAttendees  Int?
  sourceUrl          String?
  sourceSiteId       String?
  organizerName      String?
  organizerTitle     String?
  organizerEmail     String?
  organizerPhone     String?
  contactNote        String?
  status             EventStatus @default(new)
  dateAdded          DateTime    @default(now())
  runId              String?
  venueId            String?     // FK to Location (VENUE type) when matched at venue level
  matchType          EventMatchType?
  rawVenueText       String?     // raw venue name text from the listing block
  rawLocationText    String?     // raw city/state text from the listing block
  sourceUrlIsListingFallback Boolean @default(false)
  seenBlockId        String?     // FK to SeenBlock if this event was created via block dedup
  extractionMethod   ExtractionMethod?

  location   Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  venue     Location?       @relation("VenueEvents", fields: [venueId], references: [id], onDelete: SetNull)
  run        IngestionRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  sourceSite SourceSite?     @relation(fields: [sourceSiteId], references: [id], onDelete: SetNull)
  contacts   EventContact[]
  seenBlock  SeenBlock?     @relation(fields: [seenBlockId], references: [id], onDelete: SetNull)
  detailPages EventDetailPage[]
  notes      Note[]

  @@unique([locationId, eventName, eventDateStart])
  @@map("events")
}

enum EventStatus {
  new
  reviewed
  contacted
}

// ─── Ingestion Run ────────────────────────────────────────────────────────────

model IngestionRun {
  id           String     @id @default(cuid())
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  trigger      RunTrigger
  status       RunStatus  @default(running)
  recordsFound Int        @default(0)
  recordsNew   Int        @default(0)
  errorMessage String?
  providersUsed Json?

  events Event[]

  @@map("ingestion_runs")
}

enum RunTrigger {
  scheduled
  manual
}

enum RunStatus {
  running
  success
  failed
}

// ─── Source Site ──────────────────────────────────────────────────────────────
// sourceMode separates "can this even be automated" from "how" (scrapeMode).
// Manual sources skip SourceSiteConfig entirely and just get a reminder cadence.

enum SourceMode {
  automated
  manual
}

model SourceSite {
  id                    String        @id @default(cuid())
  name                  String
  url                   String?
  active                Boolean       @default(true)
  sourceMode            SourceMode    @default(automated)
  urlPattern            String?
  scrapeMode            ScrapeMode    @default(auto)
  notes                 String?
  lastScrapedAt         DateTime?
  lastScrapeStatus      ScrapeStatus?
  manualCheckFrequencyDays Int?
  lastManualCheckAt     DateTime?
  eventsFound           Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  events           Event[]
  sourceSiteConfig SourceSiteConfig?

  @@map("source_sites")
}

enum ScrapeMode {
  auto
  calendar
  directory
  search
  ica
  skip
}

enum ScrapeStatus {
  success
  partial
  failed
  blocked
}

// ─── Source Site Config ───────────────────────────────────────────────────────

model SourceSiteConfig {
  id              String      @id @default(cuid())
  sourceSiteId    String      @unique
  sourceSite      SourceSite  @relation(fields: [sourceSiteId], references: [id], onDelete: Cascade)

  paginationType  String?
  paginationParam String?
  paginationStart Int         @default(1)
  maxPages        Int         @default(5)

  listingUrlTemplate String?

  selectorEventContainer  String?
  selectorEventName       String?
  selectorEventDateStart  String?
  selectorEventDateEnd    String?
  selectorEventUrl        String?
  selectorVenue           String?
  selectorCity            String?

  followDetailPage        Boolean     @default(false)
  firecrawlFallback       Boolean     @default(true)
  aiFallback              Boolean     @default(false)
  selectorDetailOrganizer String?
  selectorDetailEmail     String?
  selectorDetailPhone     String?

  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestNotes   String?

  updatedAt       DateTime    @updatedAt

  @@map("source_site_configs")
}

// ─── Ingestion Schedule ──────────────────────────────────────────────────────

model IngestionSchedule {
  id            String   @id @default(cuid())
  name          String
  cronExpr      String
  locationIds   String[]
  templateIds   String[]
  sourceSiteIds String[]
  active        Boolean  @default(true)
  lastRunAt     DateTime?
  runHistory    Json?    // Track runs per location/search term for frequency limiting
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("ingestion_schedules")
}

// ─── Ingest Config (per-scraper settings) ──────────────────────────────────

model IngestConfig {
  id           String   @id @default(cuid())
  scraper      String   @unique  // e.g. "ica", "cn", "aca", "tf", "showsbee", "eventseye"
  maxMonths    Int      @default(6)  // how many months ahead (ICA only)
  maxPages     Int      @default(3)  // max listing pages per city/slug
  maxLocations Int      @default(0)  // 0 = unlimited, N = cap cities per run
  active       Boolean  @default(true)
  batchSize    Int      @default(5)   // how many listing pages per batch (TheTradeShowCalendar)
  batchDelayMs Int      @default(10000) // ms to sleep between batches (TheTradeShowCalendar)
  updatedAt    DateTime @updatedAt

  @@map("ingest_configs")
}

// ─── Crawled URL (change detection cache) ────────────────────────────────────

model CrawledUrl {
  url           String    @id
  contentHash   String?
  scrapedAt     DateTime  @default(now())
  runId         String?
  sourceSiteId  String?

  @@index([scrapedAt])
  @@index([sourceSiteId])
  @@map("crawled_urls")
}

// ─── Event Contact ───────────────────────────────────────────────────────────

model EventContact {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  sourceUrl String?
  confidence String  @default("medium")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  notes Note[]

  @@map("event_contacts")
}

// ─── Venue Directory Sources ─────────────────────────────────────────────────

enum DirectoryType {
  per_venue_page   // single-venue event calendar page — Path A applies
  city_aggregator  // multi-venue city calendar — falls to Path B
  official_site    // the venue's own homepage — auto-created from batch Official Site column
}

enum FetchStrategy {
  jina_markdown          // r.jina.ai/ URL → markdown (default for health-checked sources)
  puppeteer_html         // headless Chrome → HTML/DOM (for JS-rendered sites)
  gemini_url_context     // Gemini Interactions API with url_context tool
  gemini_location_search // Gemini Interactions API with google_search tool
}

enum ExtractionMethod {
  jina_markdown
  puppeteer_html
  gemini_url_context
  gemini_location_search
}

enum HealthStatus {
  unconfirmed          // not yet checked
  valid                // confirmed live, returns events
  suggested_correction // health check found a better URL
  broken               // no working calendar found
}

model Directory {
  id          String       @id @default(cuid())
  name        String       // display name e.g. "10times /events"
  baseUrl     String       @unique  // root domain e.g. "https://www.paconvention.com"
  type        DirectoryType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sources     VenueDirectorySource[]

  @@map("directories")
}

model VenueDirectorySource {
  id                   String        @id @default(cuid())
  directoryId          String
  venueId              String        // FK to Location (VENUE type) — the venue this source is for
  sourceUrl            String?       // full URL being scraped e.g. "https://www.paconvention.com/events"
  strategy             FetchStrategy @default(jina_markdown)
  isActive             Boolean       @default(true)
  lastFullHash         String?       // hash of last-seen full listing content
  lastScrapedAt        DateTime?
  nextCheckAt          DateTime?
  healthStatus         HealthStatus  @default(unconfirmed)
  suggestedUrl         String?       // better URL found by health-check discovery
  discoveryMethod      String?       // how the suggestion was found e.g. "sitemap" | "path_discovery" | "content_validation"
  discoveryConfidence   Float?        // 0.0–1.0 confidence in the suggested URL
  originalSourceUrl    String?       // preserved when suggestion replaces sourceUrl after manual approval
  batchSize            Int           @default(5)   // listing pages per batch save
  batchDelayMs         Int           @default(10000)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  directory            Directory     @relation(fields: [directoryId], references: [id], onDelete: Cascade)
  venue                Location      @relation("VenueDirectorySources", fields: [venueId], references: [id], onDelete: Cascade)
  seenBlocks           SeenBlock[]

  @@unique([directoryId, venueId, sourceUrl])
  @@map("venue_directory_sources")
}

// ─── Block-level dedup (listing page) ──────────────────────────────────────

model SeenBlock {
  id           String    @id @default(cuid())
  sourceId     String    // FK to VenueDirectorySource
  blockHash    String    // hash of the full block content
  identityKey  String    // regex-derived name+date key for edit detection
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())

  source       VenueDirectorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  events       Event[]

  @@unique([sourceId, blockHash])
  @@unique([sourceId, identityKey])
  @@index([sourceId, lastSeenAt])
  @@map("seen_blocks")
}

// ─── Detail page tracking ───────────────────────────────────────────────────

model EventDetailPage {
  id           String    @id @default(cuid())
  eventId      String
  url          String    // the detail page URL
  fullHash     String?   // hash of full page content
  rawMarkdown  String?   // last-fetched markdown content
  nextCheckAt  DateTime?
  lastFetchedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sections     EventDetailSection[]

  @@unique([eventId, url])
  @@map("event_detail_pages")
}

model EventDetailSection {
  id                String  @id @default(cuid())
  eventDetailPageId String
  sectionName       String  // e.g. "Description", "Agenda", "Speakers", "Venue Info"
  sectionHash       String
  content           String  // last-fetched section content
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  eventDetailPage   EventDetailPage @relation(fields: [eventDetailPageId], references: [id], onDelete: Cascade)

  @@unique([eventDetailPageId, sectionName])
  @@map("event_detail_sections")
}

// ─── Notes ─────────────────────────────────────────────────────────────────────
// Independent notes system to track what happened with dates.
// Can be associated with Events, Locations, or EventContacts.

enum NoteType {
  general
  contact_attempt
  follow_up
  status_change
  venue_update
  research
  other
}

model Note {
  id          String   @id @default(cuid())
  content     String   // what happened
  noteType    NoteType @default(general)
  notedAt     DateTime @default(now()) // when the event being noted occurred
  createdAt   DateTime @default(now()) // when the note was created
  updatedAt   DateTime @updatedAt

  // Entity associations (one of these will be set)
  eventId     String?
  locationId  String?
  contactId   String?

  event     Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location  Location?    @relation("LocationNotes", fields: [locationId], references: [id], onDelete: Cascade)
  contact   EventContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([locationId])
  @@index([contactId])
  @@index([notedAt])
  @@map("notes")
}
